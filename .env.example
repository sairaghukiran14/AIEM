# MongoDB connection string.
# Local:  mongodb://127.0.0.1:27017/ai-engineering-mastery
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ai-engineering-mastery
MONGODB_URI=mongodb://127.0.0.1:27017/ai-engineering-mastery

# Secret used to sign session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace-me-with-a-long-random-string

# Dev-only review switch. 1 = every published track is unlocked. Ignored in production builds.
# REVIEW_UNLOCK_ALL=1

# Dev only. Extra hostnames allowed to load the dev server (comma separated).
# localhost, 127.0.0.1 and 192.168.x.x are always allowed. Without this, opening the
# app by another hostname renders the page but never hydrates, so buttons do nothing.
# DEV_ALLOWED_ORIGINS=my-laptop.local

# Public origin, used in certificate links and password-reset emails. Defaults to the request's origin.
# SITE_URL=https://your-app.vercel.app

# Password-reset email, sent through Resend (https://resend.com). Without these, development logs the
# reset link to the server console, and production logs an error and sends nothing.
# RESEND_API_KEY=re_xxxxxxxxxxxx
# MAIL_FROM=AIEM <no-reply@yourdomain.com>

# Certificates are held until the person confirms their email. By default this is on exactly when email
# is configured (above), because requiring it when nobody can receive the email would lock everyone out.
# 1 forces it on, 0 forces it off.
# REQUIRE_EMAIL_VERIFICATION=1

# Set to 1 only if the app runs behind a proxy that overwrites X-Forwarded-For (a load balancer, nginx, Cloudflare).
# It is trusted automatically on Vercel. Without it, per-address rate limits are skipped (per-account limits still apply),
# because anyone could otherwise forge the header to dodge them.
# TRUST_PROXY_HEADERS=1
